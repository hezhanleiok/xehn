{
  "id": "<WARP 设备 id：36 位十六进制>",
  "token": "<设备 token>",
  "private_key": "<base64：32 字节 curve25519 私钥>",
  "peer_public_key": "<base64：32 字节服务端公钥>",
  "ipv4": "172.16.0.2",
  "ipv6": "<分配的 IPv6 地址>",

  "masque": {
    "id": "<第二台设备，MASQUE 专用>",
    "token": "<设备 token>",
    "private_key": "<base64：secp256r1 私钥的 DER（登记会把设备改成 masque/ec）>",
    "peer_public_key": "<base64>",
    "ipv4": "172.16.0.2",
    "ipv6": "<分配的 IPv6 地址>"
  },

  "outer": {
    "id": "<第三台设备，WARP-in-WARP 的外层>",
    "token": "<设备 token>",
    "private_key": "<base64：32 字节 curve25519 私钥>",
    "peer_public_key": "<base64>",
    "ipv4": "172.16.0.2",
    "ipv6": "<分配的 IPv6 地址>"
  }
}
